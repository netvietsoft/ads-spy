generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Search {
  id              Int      @id @default(autoincrement())
  domain          String
  createdAt       DateTime @default(now())
  advertiserCount Int      @default(0)
  creativeCount   Int      @default(0)
  totalMin        Int?
  totalMax        Int?
  advertisers     Advertiser[]
  creatives       Creative[]
}

model Advertiser {
  id        Int     @id @default(autoincrement())
  arId      String // AR...
  name      String
  domain    String?
  adCount   Int     @default(0)
  search    Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId  Int
}

model Creative {
  id           Int      @id @default(autoincrement())
  crId         String // CR...
  advertiserId String // AR...
  advertiserName String @default("")
  domain       String?
  assetType    String   @default("unknown")
  assetUrl     String?
  firstShown   Int?
  lastShown    Int?
  search       Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId     Int
}

// Cache OCR domain đích của creative Google — khoá theo crId (id creative toàn cục, ổn định), nên OCR
// một creative CHỈ MỘT LẦN dù nó xuất hiện ở nhiều lần tra cứu. Bảng RIÊNG (không nhét vào Creative vì
// Creative gắn theo từng Search, sẽ OCR lặp mỗi search).
model CreativeOcr {
  crId      String   @id
  domain    String?
  text      String?
  status    String   // ok | nodomain | empty | error
  updatedAt DateTime @default(now())
}

// Cache DETAIL gom được của creative (regions/format/domain/thumb) — khoá theo crId (ổn định toàn cục).
// Có row = đã mở chi tiết THÀNH CÔNG creative này. Nhờ vậy: (1) tra lại cùng advertiser điền tức thì +
// đủ, KHÔNG gọi lại Google (đỡ throttle); (2) một lần tra thiếu (Google chặn) → lần sau chỉ fetch phần
// CÒN THIẾU → dồn dần tới 100%. regions = danh sách mã nước nối bằng dấu phẩy ("" = fetch OK nhưng
// Google không trả vùng). Làm mới theo TTL (xem SearchService.DETAIL_CACHE_TTL_MS).
model CreativeDetailCache {
  crId      String   @id
  regions   String   @default("") // "2840,2841" — rỗng = không có vùng
  format    String   @default("unknown") // text | image | video | unknown
  domain    String? // domain đích cuối cùng (content.js hoặc OCR); null = không đọc được
  thumb     String? // URL thumbnail ad động
  updatedAt DateTime @default(now())
}

// ---- Cấu hình FB (lưu cookie phiên để sống qua restart) ----
model FbSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// ---- Lịch sử quét bài viết Page ----
model FbPagePostsScan {
  id        Int         @id @default(autoincrement())
  page      String
  fromDate  String?
  toDate    String?
  createdAt DateTime    @default(now())
  count     Int         @default(0)
  posts     FbPostRow[]
}

model FbPostRow {
  id          Int             @id @default(autoincrement())
  postId      String?
  url         String?
  text        String?
  time        Int?
  image       String?
  isVideo     Boolean         @default(false)
  hasActiveAd Boolean         @default(false)
  reactions   Int             @default(0)
  comments    Int             @default(0)
  shares      Int             @default(0)
  total       Int             @default(0)
  scan        FbPagePostsScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId      Int
}

// ---- Đối thủ theo dõi (favorites) — cho cả Google lẫn Facebook ----
model Favorite {
  id        Int      @id @default(autoincrement())
  source    String // 'google' | 'facebook'
  query     String // domain/keyword (google) | keyword/link/page_id (fb)
  country   String? // chỉ dùng cho facebook
  label     String?
  createdAt DateTime @default(now())
}

// ---- Facebook Ad Library ----
model FbSearch {
  id        Int      @id @default(autoincrement())
  query     String
  country   String
  createdAt DateTime @default(now())
  adCount   Int      @default(0)
  ads       FbAd[]
}

model FbAd {
  id            Int      @id @default(autoincrement())
  adArchiveId   String
  pageId        String?
  pageName      String   @default("")
  isActive      Boolean?
  platforms     String?  // JSON array
  bodyText      String?
  linkUrl       String?
  ctaText       String?
  images        String?  // JSON array
  videos        String?  // JSON array
  startedRunning String?
  snapshotUrl   String?
  fbSearch      FbSearch @relation(fields: [fbSearchId], references: [id], onDelete: Cascade)
  fbSearchId    Int
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String?
  name         String?
  phone        String?
  role         String    @default("user")   // 'admin' | 'manager' | 'user'
  status       String    @default("active") // 'active' | 'banned' | 'disabled'
  googleId     String?   @unique
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  subscriptions Subscription[]
  payments     Payment[]
}

model Session {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Module {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  name          String
  category      String?
  isFree        Boolean  @default(false)
  freeFeatures  String?  // JSON {feat:bool}
  freeRecordCap Int?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  plans         Plan[]
}

model Plan {
  id           Int      @id @default(autoincrement())
  module       Module   @relation(fields: [moduleKey], references: [key], onDelete: Cascade)
  moduleKey    String
  tier         String
  name         String
  priceMonthly Int      @default(0) // cents
  priceYearly  Int      @default(0) // cents
  currency     String   @default("USD")
  stripePriceMonthly String?
  stripePriceYearly  String?
  features     String   @default("{}") // JSON
  quotas       String   @default("{}") // JSON
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([moduleKey, tier])
  @@index([moduleKey])
}

model Subscription {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  moduleKey        String
  tier             String
  cycle            String   // 'monthly'|'yearly'|'comp'
  startedAt        DateTime @default(now())
  expiresAt        DateTime
  status           String   @default("active") // 'active'|'canceled'|'expired'
  note             String?
  stripeSubscriptionId String?
  featuresSnapshot String   @default("{}")
  quotasSnapshot   String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
}

model Usage {
  id        Int      @id @default(autoincrement())
  userId    Int
  moduleKey String
  metric    String
  period    String   // 'YYYY-MM'
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey, metric, period])
}

model Payment {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  provider    String    // 'stripe' | 'qr'
  amount      Int       // minor-unit của currency
  currency    String    // 'USD' | 'VND'
  status      String    @default("pending") // 'pending' | 'paid' | 'failed'
  providerRef String    @unique
  moduleKey   String
  tier        String
  cycle       String
  note        String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([userId])
}

model ProcessedEvent {
  id        Int      @id @default(autoincrement())
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

model GrantLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  actorUserId Int?
  action      String   // 'grant'|'extend'|'revoke'|'grant-module'
  moduleKey   String?
  tier        String?
  cycle       String?
  detail      String?  // JSON
  createdAt   DateTime @default(now())

  @@index([userId])
}
